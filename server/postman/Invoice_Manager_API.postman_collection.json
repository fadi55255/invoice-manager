{
  "info": {
    "name": "Invoice Manager API (Contacts & Invoices List)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "contactId", "value": "11111111-1111-4111-8111-111111111101" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Contacts - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-dev-role", "value": "admin" }],
        "url": "{{baseUrl}}/contacts?type=all&archived=false"
      }
    },
    {
      "name": "Contacts - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-dev-role", "value": "accountant" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"client\",\n  \"name\": \"SARL Numidia Tech\",\n  \"email\": \"facturation@numidia.dz\",\n  \"phone\": \"0555 11 22 33\",\n  \"nif\": \"002016012345678\",\n  \"address\": \"Rue Didouche Mourad\",\n  \"city\": \"Alger\",\n  \"postalCode\": \"16000\"\n}"
        },
        "url": "{{baseUrl}}/contacts"
      }
    },
    {
      "name": "Contacts - Edit (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-dev-role", "value": "accountant" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"0555 99 88 77\",\n  \"city\": \"Oran\"\n}"
        },
        "url": "{{baseUrl}}/contacts/{{contactId}}"
      }
    },
    {
      "name": "Contacts - Archive",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "x-dev-role", "value": "accountant" }],
        "url": "{{baseUrl}}/contacts/{{contactId}}/archive"
      }
    },
    {
      "name": "Invoices - List All (with KPIs & 6 Statuses)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-dev-role", "value": "viewer" }],
        "url": "{{baseUrl}}/invoices?page=1&limit=10"
      }
    },
    {
      "name": "Invoices - Filter by Status (overdue,partially_paid)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-dev-role", "value": "viewer" }],
        "url": "{{baseUrl}}/invoices?status=overdue,partially_paid&direction=vente"
      }
    },
    {
      "name": "Invoices - Get 6 Statuses Metadata",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-dev-role", "value": "viewer" }],
        "url": "{{baseUrl}}/invoices/statuses"
      }
    },
    {
      "name": "Invoices - Export CSV",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-dev-role", "value": "viewer" }],
        "url": "{{baseUrl}}/invoices/export"
      }
    }
  ]
}
